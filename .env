# Database connection (SQLite for zero-friction local run; switch to PostgreSQL when connecting to Postgres DB)
DATABASE_URL="file:./dev.db"

# PostgreSQL example (uncomment and replace when using PostgreSQL):
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/meesho_verifier?schema=public"

# Secret salt used for HMAC-SHA256 phone hashing. Never expose this salt publicly!
PHONE_HASH_SALT="c6e7339d2c124806a6b83f3e1b7f94bc41a99a80e1ecfd331c19b626ec17d692"

# Server-issued token for privileged / bulk checking endpoints
API_AUTH_SECRET="meesho_secure_verifier_token_2026_xyz"

# Rate limiting settings (abuse protection)
RATE_LIMIT_MAX_REQUESTS="20"
RATE_LIMIT_WINDOW_MS="60000"
