# Database connection
DATABASE_URL="file:./dev.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/meesho_verifier?schema=public"

# Secret salt for HMAC-SHA256 phone hashing
PHONE_HASH_SALT="change_this_to_a_random_32_byte_hex_string"

# Authorization secret for privileged endpoints
API_AUTH_SECRET="your_server_issued_token_here"

# Rate limiting
RATE_LIMIT_MAX_REQUESTS="20"
RATE_LIMIT_WINDOW_MS="60000"
